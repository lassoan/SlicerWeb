# Settings of a SlicerWeb build, for slicerweb.py (or slicerweb.bat): copy to a file outside the
# checkouts - for example D:/SlicerWeb-build/slicerweb-app.env - and set the paths of this computer.
# The checkouts hold sources only; everything built goes to SW_DIST, also what npm installs (the web
# application is built, served and tested in a copy of web/ there). A relative path is relative to
# this file. No secrets here: they go in the files of SW_SECRETS.
#
#     python C:/D/SlicerWeb/slicerweb.py D:/SlicerWeb-build/slicerweb-app.env build
#     python C:/D/SlicerWeb/slicerweb.py D:/SlicerWeb-build/slicerweb-app.env build SlicerHeart SlicerRT
#     python C:/D/SlicerWeb/slicerweb.py D:/SlicerWeb-build/slicerweb-app.env deploy latest
#     python C:/D/SlicerWeb/slicerweb.py D:/SlicerWeb-build/slicerweb-app.env serve
#     python C:/D/SlicerWeb/slicerweb.py D:/SlicerWeb-build/slicerweb.env dev
#     python C:/D/SlicerWeb/slicerweb.py D:/SlicerWeb-build/slicerweb.env test tests/log-window.mjs http://localhost:5173/

# The SlicerWeb checkout (default: the one slicerweb.py is in)
SW_SLICERWEB=C:/D/SlicerWeb
# The deployment checkout: which extensions, and where the build is published (docs/extensions.md).
# Without one, the build has the extensions of SlicerWeb and is not published.
SW_DEPLOYMENT=C:/D/slicerweb-app
# Where everything built goes: wheels, extensions, the web application, sample data
SW_DIST=D:/SlicerWeb-build/dist-slicerweb-app
# A folder of secrets: github-token, read access to private extensions (optional)
#SW_SECRETS=D:/SlicerWeb-build/secrets/slicerweb-app
# The port of serve
SW_PORT=4176
# The port of dev, the development server of the web application (default 5173)
#SW_DEV_PORT=5173
