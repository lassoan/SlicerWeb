# Settings of this computer for build.py and scripts/publish_*.py: copy to local.env (not committed)
# and set what differs from the defaults. An environment variable of the same name overrides a line.
# No secrets here: they go in .secrets/ of a deployment folder (--deployment, docs/extensions.md),
# which has a local.env of its own too, with the same settings.

# Where the build copies the wheels and web bundles (default: ~/SlicerWeb-build/dist)
#SW_DIST=D:/SlicerWeb-build/dist
# The folder of extension description files 80-extensions builds (default: extensions/ of this repository)
#SW_EXTENSIONS_DIR=C:/D/SlicerWebExtensions
# The repository whose "runtime" release publish_runtime.py uploads to (default: lassoan/SlicerWeb)
#SW_RUNTIME_REPOSITORY=myorg/slicerweb-deploy
