From b25be3b786bc43dd929471e41859ae774673d4f2 Mon Sep 17 00:00:00 2001
From: Andras Lasso <lasso@queensu.ca>
Date: Wed, 30 Sep 2026 00:48:55 -0400
Subject: [PATCH] ENH: Allow building vtkITK with DICOM support without DCMTK

vtkITK DICOM support (VTKITK_BUILD_DICOM_SUPPORT) required both GDCM and
DCMTK image IO of ITK. Without DICOM support a series of DICOM files could
not be loaded as a volume: when a list of files was specified, the DICOM
headers were not analyzed, so assembling the volume failed ("index archetype
0 is out of bounds") and only single slices could be loaded.

DCMTK support is now optional (VTKITK_BUILD_DCMTK_SUPPORT, enabled by
default if DICOM support is enabled), so vtkITK can be built with DICOM
support using only GDCM, for example when ITK is built without DCMTK (such
as the web version of Slicer). If DCMTK is requested as DICOM image IO
approach but it is not available then GDCM is used.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libs/vtkITK/CMakeLists.txt                    |  7 +++++
 .../vtkITKArchetypeImageSeriesReader.cxx      | 31 +++++++++++++++----
 .../vtkITK/vtkITKArchetypeImageSeriesReader.h |  5 +++
 ...vtkITKArchetypeImageSeriesScalarReader.cxx | 16 ++--------
 ...ArchetypeImageSeriesVectorReaderSeries.cxx | 13 ++------
 Libs/vtkITK/vtkITKConfigure.h.in              |  1 +
 6 files changed, 42 insertions(+), 31 deletions(-)

diff --git a/Libs/vtkITK/CMakeLists.txt b/Libs/vtkITK/CMakeLists.txt
index 8ff0be4869..d76e25c106 100644
--- a/Libs/vtkITK/CMakeLists.txt
+++ b/Libs/vtkITK/CMakeLists.txt
@@ -14,6 +14,13 @@ endif()
 if(NOT DEFINED VTKITK_BUILD_DICOM_SUPPORT)
   option(VTKITK_BUILD_DICOM_SUPPORT "Build with DICOM support" ON)
 endif()
+# DICOM files are read using GDCM. DCMTK can be used as well, if it is available in ITK (ITKIODCMTK module).
+if(NOT DEFINED VTKITK_BUILD_DCMTK_SUPPORT)
+  option(VTKITK_BUILD_DCMTK_SUPPORT "Build with support for reading DICOM files using DCMTK" ${VTKITK_BUILD_DICOM_SUPPORT})
+endif()
+if(VTKITK_BUILD_DCMTK_SUPPORT AND NOT VTKITK_BUILD_DICOM_SUPPORT)
+  message(FATAL_ERROR "VTKITK_BUILD_DCMTK_SUPPORT requires VTKITK_BUILD_DICOM_SUPPORT")
+endif()
 
 # --------------------------------------------------------------------------
 # Dependencies
diff --git a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx
index 76b1bc2006..f7b37acc06 100644
--- a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx
+++ b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx
@@ -49,10 +49,12 @@
 #include "itkOrientImageFilter.h"
 #include "itkImageSeriesReader.h"
 #ifdef VTKITK_BUILD_DICOM_SUPPORT
-# include "itkDCMTKImageIO.h"
 # include "itkGDCMSeriesFileNames.h"
 # include "itkGDCMImageIO.h"
 #endif
+#ifdef VTKITK_BUILD_DCMTK_SUPPORT
+# include "itkDCMTKImageIO.h"
+#endif
 
 vtkStandardNewMacro(vtkITKArchetypeImageSeriesReader);
 
@@ -181,6 +183,25 @@ void vtkITKArchetypeImageSeriesReader::PrintSelf(ostream& os, vtkIndent indent)
 #endif
 }
 
+//----------------------------------------------------------------------------
+itk::ImageIOBase::Pointer vtkITKArchetypeImageSeriesReader::CreateDICOMImageIO(int dicomImageIOApproach)
+{
+#ifdef VTKITK_BUILD_DICOM_SUPPORT
+  if (dicomImageIOApproach == vtkITKArchetypeImageSeriesReader::GDCM)
+  {
+    return itk::GDCMImageIO::New().GetPointer();
+  }
+#endif
+#ifdef VTKITK_BUILD_DCMTK_SUPPORT
+  if (dicomImageIOApproach == vtkITKArchetypeImageSeriesReader::DCMTK)
+  {
+    return itk::DCMTKImageIO::New().GetPointer();
+  }
+#endif
+  (void)dicomImageIOApproach; // unused if built without DICOM support
+  return nullptr;
+}
+
 //----------------------------------------------------------------------------
 int vtkITKArchetypeImageSeriesReader::CanReadFile(const char* filename)
 {
@@ -241,12 +262,10 @@ itk::ImageIOBase::Pointer vtkITKArchetypeImageSeriesReader::GetImageIO(const cha
   {
     // Some file types require special processing
 #ifdef VTKITK_BUILD_DICOM_SUPPORT
-    if (this->GetDICOMImageIOApproach() == vtkITKArchetypeImageSeriesReader::DCMTK)
-    {
-      dicomIO = itk::DCMTKImageIO::New();
-    }
-    else
+    dicomIO = vtkITKArchetypeImageSeriesReader::CreateDICOMImageIO(this->GetDICOMImageIOApproach());
+    if (!dicomIO)
     {
+      vtkWarningMacro("DICOM image IO approach " << this->GetDICOMImageIOApproach() << " is not supported, GDCM is used instead");
       dicomIO = itk::GDCMImageIO::New();
     }
 
diff --git a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h
index 1b8a77edd0..cfafc03ec5 100644
--- a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h
+++ b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h
@@ -758,6 +758,11 @@ public:
   /// ITK can only read NIfTI-1 files, therefore this can be used for explaining why reading of a file failed.
   static bool IsNifti2File(const char* fileName);
 
+  /// Create an image IO for reading DICOM files using the specified approach (GDCM or DCMTK).
+  /// Returns nullptr if the approach is not supported (the application is built without DICOM support,
+  /// or DCMTK is requested but the application is built without DCMTK support).
+  static itk::ImageIOBase::Pointer CreateDICOMImageIO(int dicomImageIOApproach);
+
 protected:
   vtkITKArchetypeImageSeriesReader();
   ~vtkITKArchetypeImageSeriesReader() override;
diff --git a/Libs/vtkITK/vtkITKArchetypeImageSeriesScalarReader.cxx b/Libs/vtkITK/vtkITKArchetypeImageSeriesScalarReader.cxx
index c98201f0d1..ad098d2bb7 100644
--- a/Libs/vtkITK/vtkITKArchetypeImageSeriesScalarReader.cxx
+++ b/Libs/vtkITK/vtkITKArchetypeImageSeriesScalarReader.cxx
@@ -30,10 +30,6 @@
 // ITK includes
 #include <itkOrientImageFilter.h>
 #include <itkImageSeriesReader.h>
-#ifdef VTKITK_BUILD_DICOM_SUPPORT
-# include <itkDCMTKImageIO.h>
-# include <itkGDCMImageIO.h>
-#endif
 
 vtkStandardNewMacro(vtkITKArchetypeImageSeriesScalarReader);
 
@@ -88,16 +84,8 @@ int vtkITKArchetypeImageSeriesScalarReader::RequestData(vtkInformation* vtkNotUs
 #ifdef VTKITK_BUILD_DICOM_SUPPORT
 # define vtkITKExecuteDataDeclareDICOMImageIO                                                                                \
    typedef itk::ImageIOBase ImageIOType;                                                                                     \
-   ImageIOType::Pointer imageIO;                                                                                             \
-   if (this->DICOMImageIOApproach == vtkITKArchetypeImageSeriesReader::GDCM)                                                 \
-   {                                                                                                                         \
-     imageIO = itk::GDCMImageIO::New();                                                                                      \
-   }                                                                                                                         \
-   else if (this->DICOMImageIOApproach == vtkITKArchetypeImageSeriesReader::DCMTK)                                           \
-   {                                                                                                                         \
-     imageIO = itk::DCMTKImageIO::New();                                                                                     \
-   }                                                                                                                         \
-   else                                                                                                                      \
+   ImageIOType::Pointer imageIO = vtkITKArchetypeImageSeriesReader::CreateDICOMImageIO(this->DICOMImageIOApproach);          \
+   if (!imageIO)                                                                                                             \
    {                                                                                                                         \
      vtkErrorMacro(<< "vtkITKExecuteDataFromSeries: Unsupported DICOMImageIOApproach: " << this->GetDICOMImageIOApproach()); \
      this->SetErrorCode(vtkErrorCode::UnrecognizedFileTypeError);                                                            \
diff --git a/Libs/vtkITK/vtkITKArchetypeImageSeriesVectorReaderSeries.cxx b/Libs/vtkITK/vtkITKArchetypeImageSeriesVectorReaderSeries.cxx
index 5b13b735cc..25f18adb86 100644
--- a/Libs/vtkITK/vtkITKArchetypeImageSeriesVectorReaderSeries.cxx
+++ b/Libs/vtkITK/vtkITKArchetypeImageSeriesVectorReaderSeries.cxx
@@ -25,7 +25,6 @@
 #include <itkImageSeriesReader.h>
 #include <itkOrientImageFilter.h>
 #ifdef VTKITK_BUILD_DICOM_SUPPORT
-# include <itkDCMTKImageIO.h>
 # include <itkGDCMImageIO.h>
 
 // GDCM includes
@@ -76,16 +75,8 @@ void vtkITKExecuteDataFromSeriesVector(vtkITKArchetypeImageSeriesVectorReaderSer
   reader->GetOutput()->SetVectorLength(3);
 #ifdef VTKITK_BUILD_DICOM_SUPPORT
   typedef itk::ImageIOBase ImageIOType;
-  ImageIOType::Pointer imageIO;
-  if (self->GetDICOMImageIOApproach() == vtkITKArchetypeImageSeriesReader::GDCM)
-  {
-    imageIO = itk::GDCMImageIO::New();
-  }
-  else if (self->GetDICOMImageIOApproach() == vtkITKArchetypeImageSeriesReader::DCMTK)
-  {
-    imageIO = itk::DCMTKImageIO::New();
-  }
-  else
+  ImageIOType::Pointer imageIO = vtkITKArchetypeImageSeriesReader::CreateDICOMImageIO(self->GetDICOMImageIOApproach());
+  if (!imageIO)
 #endif
   {
     vtkErrorWithObjectMacro(self, << "vtkITKArchetypeImageSeriesVectorReaderSeries: Unsupported DICOMImageIOApproach: " << self->GetDICOMImageIOApproach());
diff --git a/Libs/vtkITK/vtkITKConfigure.h.in b/Libs/vtkITK/vtkITKConfigure.h.in
index d556e18dd3..80d54e1941 100644
--- a/Libs/vtkITK/vtkITKConfigure.h.in
+++ b/Libs/vtkITK/vtkITKConfigure.h.in
@@ -4,3 +4,4 @@
  */
 
 #cmakedefine VTKITK_BUILD_DICOM_SUPPORT
+#cmakedefine VTKITK_BUILD_DCMTK_SUPPORT
