From 7d67e144c4ec9ef11a36147757ac9d573b7f0130 Mon Sep 17 00:00:00 2001
From: Andras Lasso <lasso@queensu.ca>
Date: Wed, 30 Sep 2026 01:41:21 -0400
Subject: [PATCH] BUG: Fix slice order when reading DICOM series from a list of
 files

When a list of DICOM files was given to vtkITKArchetypeImageSeriesReader,
the files were supposed to be sorted by their position along the scan axis,
but they were used in the order they were specified (for example, in
alphabetical order of the file names), because of two errors:

- The position was only used if the image orientation and image position
  index of the file were both greater than 0, while they are indices of the
  distinct orientations and positions, starting from 0 (-1 means that the
  information is not available). A series with a single orientation has
  orientation index 0 for all files, so the position was never used.
- Image positions were considered to be the same if they pointed in the same
  direction from the origin (the comparison of orientations was used), so
  for example all the positions along an axis that goes through the origin
  were merged into one. Now positions are the same if they are closer than
  0.001 mm.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Libs/vtkITK/Testing/CMakeLists.txt            |  1 +
 .../vtkITKArchetypeDICOMSeriesFileList.py     | 40 +++++++++++++++++++
 .../vtkITKArchetypeImageSeriesReader.cxx      |  2 +-
 .../vtkITK/vtkITKArchetypeImageSeriesReader.h | 18 +++------
 4 files changed, 48 insertions(+), 13 deletions(-)
 create mode 100644 Libs/vtkITK/Testing/vtkITKArchetypeDICOMSeriesFileList.py

diff --git a/Libs/vtkITK/Testing/CMakeLists.txt b/Libs/vtkITK/Testing/CMakeLists.txt
index 2b5bc082c3..4da3037bbb 100644
--- a/Libs/vtkITK/Testing/CMakeLists.txt
+++ b/Libs/vtkITK/Testing/CMakeLists.txt
@@ -18,4 +18,5 @@ ExternalData_add_test(${Slicer_ExternalData_DATA_MANAGEMENT_TARGET}
   )
 
 slicer_add_python_unittest(SCRIPT vtkITKArchetypeDiffusionTensorReaderFile.py)
+slicer_add_python_unittest(SCRIPT vtkITKArchetypeDICOMSeriesFileList.py)
 slicer_add_python_unittest(SCRIPT vtkITKArchetypeScalarReaderFile.py)
diff --git a/Libs/vtkITK/Testing/vtkITKArchetypeDICOMSeriesFileList.py b/Libs/vtkITK/Testing/vtkITKArchetypeDICOMSeriesFileList.py
new file mode 100644
index 0000000000..6f105a7cc2
--- /dev/null
+++ b/Libs/vtkITK/Testing/vtkITKArchetypeDICOMSeriesFileList.py
@@ -0,0 +1,40 @@
+"""Test reading a DICOM series from a list of files that is not in the order of slice positions."""
+
+import glob
+import os
+import re
+import unittest
+
+import vtkITK
+
+
+class vtkITKArchetypeDICOMSeriesFileList(unittest.TestCase):
+    def setUp(self):
+        dataDir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", "Testing", "Data", "Input", "CTHeadAxialDicom")
+        # CTHead<N>.dcm is the N-th slice (slice position is (N - 1) * 1.5 mm).
+        # Sorting the file names alphabetically puts the slices out of order (CTHead1, CTHead10, CTHead11, ...).
+        self.fileNames = sorted(glob.glob(os.path.join(dataDir, "CTHead*.dcm")))
+        self.assertEqual(len(self.fileNames), 93)
+
+    def sliceNumber(self, fileName):
+        return int(re.search(r"CTHead(\d+)\.dcm$", fileName).group(1))
+
+    def test_file_list_sorted_by_position(self):
+        reader = vtkITK.vtkITKArchetypeImageSeriesScalarReader()
+        reader.SetArchetype(self.fileNames[0])
+        for fileName in self.fileNames:
+            reader.AddFileName(fileName)
+        reader.SetSingleFile(0)
+        reader.SetOutputScalarTypeToNative()
+        reader.SetDesiredCoordinateOrientationToNative()
+        reader.SetUseNativeOriginOn()
+        reader.Update()
+
+        self.assertEqual(reader.GetOutput().GetDimensions()[2], 93)
+        # The files are used in the order of slice positions, not in the order they were specified
+        sliceNumbers = [self.sliceNumber(reader.GetFileName(i)) for i in range(reader.GetNumberOfFileNames())]
+        self.assertEqual(sliceNumbers, list(range(1, 94)))
+
+    def runTest(self):
+        self.setUp()
+        self.test_file_list_sorted_by_position()
diff --git a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx
index 76b1bc2006..9e9e286849 100644
--- a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx
+++ b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.cxx
@@ -1685,7 +1685,7 @@ int vtkITKArchetypeImageSeriesReader::AssembleVolumeContainingArchetype()
         kth_orientation = this->IndexImageOrientationPatient[k];
         kth_position = this->IndexImagePositionPatient[k];
       }
-      if (kth_orientation > 0 && kth_position > 0)
+      if (kth_orientation >= 0 && kth_position >= 0)
       {
         if (!originSet)
         {
diff --git a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h
index 1b8a77edd0..05e1ccb02f 100644
--- a/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h
+++ b/Libs/vtkITK/vtkITKArchetypeImageSeriesReader.h
@@ -480,23 +480,17 @@ public:
 
   int ExistImagePositionPatient(float* ipp)
   {
-    float a = 0;
-    for (int n = 0; n < 3; n++)
-    {
-      a += ipp[n] * ipp[n];
-    }
-
+    // Positions are the same if they are closer than this distance (in mm)
+    const float tolerance = 1e-3;
     for (unsigned int k = 0; k < GetNumberOfImagePositionPatient(); k++)
     {
-      float b = 0;
-      float c = 0;
+      float squaredDistance = 0;
       for (int n = 0; n < 3; n++)
       {
-        b += this->ImagePositionPatient[k][n] * this->ImagePositionPatient[k][n];
-        c += this->ImagePositionPatient[k][n] * ipp[n];
+        const float difference = this->ImagePositionPatient[k][n] - ipp[n];
+        squaredDistance += difference * difference;
       }
-      c = fabs(c) / sqrt(a * b);
-      if (c > 0.99999)
+      if (squaredDistance < tolerance * tolerance)
       {
         return k;
       }
