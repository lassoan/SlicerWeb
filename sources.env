# Pinned source revisions (NAME_URL / NAME_REV), fetched by the build from the URLs themselves.
# Slicer: upstream main (2026-10-08), which has all the changes SlicerWeb needs but the GPU segmentation surfaces (patches/Slicer).
SLICER_URL=https://github.com/Slicer/Slicer.git
SLICER_REV=4e94b6d93db9ad44ad4e841ef53ca6802249caa9
# VTK: Slicer fork, same as Slicer SuperBuild/External_VTK.cmake for VTK 9.6 (slicer-v9.6.2-2026-05-15-f49a1dbaf).
# (VTK master 9.7 changed APIs used by Slicer, e.g. vtkAlgorithm::Update() now returns bool.)
VTK_URL=https://github.com/Slicer/VTK.git
VTK_REV=470a7a557adaf5f1ea8031665134d18835356b85
# ITK: Slicer fork, same commit as Slicer SuperBuild/External_ITK.cmake (slicer-v5.4.7-2026-07-21)
ITK_URL=https://github.com/Slicer/ITK.git
ITK_REV=d458a374da84b6dc0c513c40700072f218a286d2
# teem: Slicer fork (slicer-2025-05-18-r7265)
TEEM_URL=https://github.com/Slicer/teem.git
TEEM_REV=43395a690351cd98235de84775a8747d0bdae106
# vtkAddon: as pinned by Slicer SuperBuild.cmake
VTKADDON_URL=https://github.com/Slicer/vtkAddon.git
VTKADDON_REV=3dc6d63a86ed099d1da05dd10aa5ff4c49728959
# LibArchive (slicer-v3.8.1-2025-06-01)
LIBARCHIVE_URL=https://github.com/Slicer/libarchive.git
LIBARCHIVE_REV=30a9657b6c12f675fd5057cea017b2c9bd924dda
# RapidJSON (slicer-2024-12-22)
RAPIDJSON_URL=https://github.com/slicer/rapidjson.git
RAPIDJSON_REV=4da93e4b581f88fecc460e2259f468faaa438554
# JsonCpp (slicer-v1.9.6-2024-09-09)
JSONCPP_URL=https://github.com/Slicer/jsoncpp.git
